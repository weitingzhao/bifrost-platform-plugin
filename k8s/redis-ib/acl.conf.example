user default off
# Gateway + trade-prod: full IB bus write. Include daemon_* health so Trade account-sync / daemon can HSET.
user ib-gateway on >GATEWAY_PASS ~ib:* ~bifrost:health:ws_ib_* ~bifrost:health:daemon_* ~bifrost:health:account_sync_daemon allchannels +@all
user trade-prod on >TRADE_PROD_PASS ~ib:* ~bifrost:health:ws_ib_* ~bifrost:health:daemon_* ~bifrost:health:account_sync_daemon allchannels +@all
# trade-prod is PROD's alone. DEV and STG each have their own user (debt TD-21): read the IB bus,
# subscribe to its channels, and write only two things — the env's own operator stream (the gateway
# answers read ops there, never disconnect_all / reconnect_all) and on-demand quote registrations
# (SADD + heartbeat HSET). No DEL / SREM / HDEL, no PUBLISH, no health-key writes.
user trade-dev on >TRADE_DEV_PASS %R~ib:* %R~bifrost:health:ws_ib_* %R~bifrost:health:daemon_* ~ib:operator:cmd:dev ~ib:ingester:control:* ~ib:option:control:* allchannels -@all +@read +ping +echo +info +hello +client|list +client|setinfo +client|setname +client|getname +client|id +subscribe +psubscribe +unsubscribe +punsubscribe +xadd +sadd +hset
user trade-stg on >TRADE_STG_PASS %R~ib:* %R~bifrost:health:ws_ib_* %R~bifrost:health:daemon_* ~ib:operator:cmd:stg ~ib:ingester:control:* ~ib:option:control:* allchannels -@all +@read +ping +echo +info +hello +client|list +client|setinfo +client|setname +client|getname +client|id +subscribe +psubscribe +unsubscribe +punsubscribe +xadd +sadd +hset
user platform on >PLATFORM_PASS ~ib:health:* ~ib:events:* ~ib:control:* ~ib:tick:* ~ib:ingester:* ~ib:account:* ~bifrost:health:ws_ib_* ~bifrost:health:daemon_* ~bifrost:health:account_sync_daemon allchannels +@all
# ib:control:gateway_self_heal — plugin L0/L0.5 self-heal ladder (platform-api reads; ib-gateway writes)
